# Test Environment Variables
# Copy this to .env.test and fill in with your Spotify test account credentials

# Spotify Test Account (create a dedicated test account)
SPOTIFY_TEST_EMAIL=your-test-email@example.com
SPOTIFY_TEST_PASSWORD=your-test-password

# Test URLs (use 127.0.0.1 for consistency)
VITE_API_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:8000
