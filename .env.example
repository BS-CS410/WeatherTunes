# WeatherTunes Environment Variables
# Copy this file to .env and fill in your actual API keys

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here_replace_with_random_string

# Spotify API Credentials (get from https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# OpenWeather API Key (get from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key
