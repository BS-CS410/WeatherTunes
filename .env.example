# WeatherTunes Environment Variables
# Copy this file to .env and fill in your actual API keys

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here_replace_with_random_string

# Spotify API Credentials (get from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth-callback

# OpenWeather API Key (get from https://openweathermap.org/api)
VITE_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key
